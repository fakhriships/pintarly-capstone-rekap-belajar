# ---------------------------------------------------------------
# Salin file ini jadi .env.local, lalu isi dengan API key kamu.
# JANGAN commit .env.local.
#
# Key gratis (tanpa kartu kredit): https://aistudio.google.com/apikey
# ---------------------------------------------------------------

# Key hanya dibaca di server. Jangan pernah diberi prefix NEXT_PUBLIC_.
GEMINI_API_KEY=

# Nama model yang kamu pakai, misalnya varian Flash terbaru di akunmu.
GEMINI_MODEL=

# Kalau kamu memakai provider lain, tulis variabelnya di sini juga
# supaya kami tahu apa yang perlu diisi.
